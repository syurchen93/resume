---
import '../styles/global.css';
const { lang, focus = 'all' } = Astro.props;
const de = lang === 'de';
const isGo = focus === 'go';
const isPhp = focus === 'php';
const jobs = de ? [
  { company:'myposter GmbH · ein Unternehmen der ALL IN GROUP', place:'München', date:'Feb 2026 – Jul 2026', role:'Senior Developer', points:['Zentralen Checkout als REST-API neu entwickelt und die Quote erfolgreich abgeschlossener Bestellungen von 96 % auf 99 % gesteigert','Integration von Adyen, PayPal, Amazon Pay, Apple Pay, Google Pay, Unzer und Klarna','Zuverlässlichere Bestell- und Produktionsabläufe durch asynchrone Verarbeitung, Locking und Retry-Mechanismen','Go-Services zur Bildverarbeitung auf AWS Lambda entwickelt, die täglich rund 10.000 Bilder verarbeiten und die AWS-Kosten um 67 % senken','Security, Deployment und Betrieb mit Dependency Auditing, Terraform, Kubernetes und Helm verbessert; automatisierte Tests ausgebaut','KI-gestützte Entwicklungstools für Implementierung, Debugging und Tests eingesetzt und generierte Ergebnisse vor der Integration sorgfältig geprüft']},
  { company:'CHECK24', place:'München', date:'Mär 2023 – Nov 2025', role:'Professional PHP Developer', points:['Parallele Fahrzeugsuche in Go optimiert und die Antwortzeit von 5,3 auf 2,3 Sekunden reduziert','Versandkostenlogik im Symfony-Bundle sowie Preislogik flexibler und zuverlässiger gemacht','Datenbank-Integrationstests für AurumCars ergänzt und die Codeabdeckung verbessert','Fahrzeugsuche in Laminas refaktoriert und Duplikate reduziert','Internes Mietwagen-Preisvergleichstool mit Symfony, Queues und Kibana-Anbindung entwickelt','Neue Partner über APIs integriert und Redis-Adapter um Persistenzverteilung erweitert']},
  { company:'Gazprom Media Digital Innovations', place:'Moskau', date:'Nov 2020 – Dez 2022', role:'Entwickler für Sportstatistiken', points:['Sportdaten von OPTA, EnetPulse und sportbox.ru synchronisiert und integriert','Leistungsstarkes Admin-Panel mit EasyAdminBundle entwickelt','Automatisierte Testabdeckung mit Unit- und Funktionstests von 30 % auf 67 % erhöht und Textübertragungen neu gestaltet','Domain-Driven Design und Symfony für Performance und Skalierbarkeit eingesetzt']},
  { company:'Pos Credit', place:'Moskau', date:'Aug 2018 – Nov 2020', role:'PHP Developer', points:['API-SDK für eine Versicherungsgesellschaft als Symfony-Package entwickelt','Integrationen mit Partnerbanken überarbeitet und Legacy-Code modernisiert','SOAP für die Kommunikation mit Partnerdiensten eingesetzt']},
  { company:'myoffice.ru', place:'Moskau', date:'Mai 2017 – Jun 2018', role:'PHP Developer', points:['CalDAV-Kalenderserver produktiv gesetzt, kompatibel mit Apple, Outlook und Thunderbird','RabbitMQ und Symfony Messenger intensiv genutzt; eigene Queues für asynchrone Verarbeitung entwickelt']},
  { company:'Iptelofon.ru', place:'Moskau', date:'Sep 2015 – Mai 2017', role:'PHP Developer', points:['Unternehmenseigene PBX-Systeme in verschiedene CRMs integriert und konfiguriert','Eigenes Warteschlangensystem mit MySQL entwickelt und Linux-Server administriert']}
] : [
  { company:'myposter GmbH · an ALL IN GROUP company', place:'Munich', date:'Feb 2026 – Jul 2026', role:'Senior Developer', points:['Rebuilt the central checkout as a REST API, increasing the successful order rate from 96% to 99%','Integrated Adyen, PayPal, Amazon Pay, Apple Pay, Google Pay, Unzer and Klarna','Improved order and production reliability with asynchronous processing, locking and retry mechanisms','Built Go image-processing services on AWS Lambda handling around 10,000 images per day while reducing AWS costs by 67%','Improved security, deployment and operations with dependency auditing, Terraform, Kubernetes and Helm; expanded automated tests','Used AI-assisted development tools for implementation, debugging and testing, carefully reviewing generated output before integration']},
  { company:'CHECK24', place:'Munich', date:'Mar 2023 – Nov 2025', role:'Professional PHP Developer', points:['Optimized parallel vehicle search in Go, reducing response time from 5.3 seconds to 2.3 seconds','Built shipping-cost logic in a Symfony bundle and made pricing logic more flexible and reliable','Added database integration tests for AurumCars and improved code coverage','Refactored vehicle search in Laminas, reducing duplication','Built an internal car-rental price comparison tool with Symfony, queues and Kibana integration','Integrated new partners through APIs and added persistence distribution to a Redis adapter']},
  { company:'Gazprom Media Digital Innovations', place:'Moscow', date:'Nov 2020 – Dec 2022', role:'Sports Statistics Developer', points:['Synchronized and integrated sports data from OPTA, EnetPulse and sportbox.ru','Built a high-performance admin panel with EasyAdminBundle','Increased automated test coverage from 30% to 67% with unit and functional tests and redesigned text broadcasts','Applied Domain-Driven Design and Symfony to support performance and scalability']},
  { company:'Pos Credit', place:'Moscow', date:'Aug 2018 – Nov 2020', role:'PHP Developer', points:['Developed an API SDK for an insurance company as a Symfony package','Reworked partner-bank integrations and modernized legacy code','Used SOAP to communicate with partner services']},
  { company:'myoffice.ru', place:'Moscow', date:'May 2017 – Jun 2018', role:'PHP Developer', points:['Launched a CalDAV calendar server in production, compatible with Apple, Outlook and Thunderbird','Used RabbitMQ and Symfony Messenger extensively and built custom queues for asynchronous processing']},
  { company:'Iptelofon.ru', place:'Moscow', date:'Sep 2015 – May 2017', role:'PHP Developer', points:['Integrated and configured company PBX systems with multiple CRMs','Built a custom MySQL queue system and administered Linux servers']}
];
const projects = de ? [
  {name:'Telegram-Bot für Fußball-Spielpläne', href:'https://github.com/syurchen93/schedule', desc:'Entwickelte einen Telegram-Bot für personalisierte Fußball-Spielpläne, Benachrichtigungen, Tabellen und Spielinformationen', note:'Live-Demos sind wegen geänderter Preise des API-Anbieters nicht mehr verfügbar', details:['SDK für die Football-Daten-API api-football-client entwickelt','Spieldaten und Tabellenstände abgerufen','Zeitzone anhand des Standorts bestimmt','Personalisierte Spielpläne, Benachrichtigungen und Teilen von Alarmen ermöglicht','Turniertabellen als Bild generiert'], resources:[{label:'api-football-client SDK',href:'https://github.com/syurchen93/api-football-client'}], tech:'Go · go-telegram · GORM · Testify · otter · MySQL · Telegram Bot API'},
  {name:'Tarkov.help', href:'https://tarkov.help/', desc:'Spieldaten-Website mit asynchronen Gewinnberechnungen, Event-Pushs, interaktiven Karten und Nutzerprofilen', details:['Bis zu 100.000 Nutzer pro Tag unterstützt','Asynchrone Gewinnberechnungen für 2.000 Handels- und Crafting-Rezepte entwickelt','Umfassende Spieldaten für ein populäres Online-Spiel bereitgestellt','Push-Benachrichtigungen für Events integriert','Interaktive Karten und Nutzerprofile mit Premium-Funktionen umgesetzt'], tech:'PHP 8.1 · Symfony 5.4 · Docker · MySQL · Redis · Mercure · Trello · GitLab CI · Graylog · Kubernetes'},
  {name:'Football Schedule Project (2019)', desc:'Entwickelte eine Anwendung für Fußballdaten und Tabellen, die Organisation vergangener Spiele und Telegram-Erinnerungen zum Anpfiff', note:'Live-Demos sind wegen geänderter Preise des API-Anbieters nicht mehr verfügbar', details:['Spiel- und Tabellendaten abgerufen','Vergangene Spiele organisiert','Telegram-Benachrichtigungen zum Spielbeginn versendet'], tech:'PHP 7.4 · Symfony 5.1 · MySQL · Telegram Bot API'}
] : [
  {name:'Football Schedule Telegram Bot', href:'https://github.com/syurchen93/schedule', desc:'Built a Telegram bot for personalized football schedules, notifications, standings and match information', note:'Live demos are no longer available because the API provider changed its pricing', details:['Built an SDK for the api-football-client data API','Retrieved match data and league standings','Determined the user time zone from their location','Provided personalized schedules, notifications and shared alarms','Generated tournament tables as images'], resources:[{label:'api-football-client SDK',href:'https://github.com/syurchen93/api-football-client'}], tech:'Go · go-telegram · GORM · Testify · otter · MySQL · Telegram Bot API'},
  {name:'Tarkov.help', href:'https://tarkov.help/', desc:'Game data website with asynchronous profit calculations, event notifications, interactive maps and user profiles', details:['Supported up to 100,000 users per day','Built asynchronous profit calculations for 2,000 trading and crafting recipes','Provided comprehensive game data for a popular online game','Integrated push notifications for events','Implemented interactive maps and user profiles with premium features'], tech:'PHP 8.1 · Symfony 5.4 · Docker · MySQL · Redis · Mercure · Trello · GitLab CI · Graylog · Kubernetes'},
  {name:'Football Schedule Project (2019)', desc:'Built an application for football data and standings, recent match organization, and Telegram kick-off reminders', note:'Live demos are no longer available because the API provider changed its pricing', details:['Retrieved match and league standings data','Organized recent matches','Sent Telegram notifications when matches were about to start'], tech:'PHP 7.4 · Symfony 5.1 · MySQL · Telegram Bot API'}
];
const title = isGo
  ? (de ? 'Go-Backendentwickler | Go & AWS' : 'Go Backend Developer | Go & AWS')
  : isPhp
    ? (de ? 'PHP-Entwickler | PHP & Symfony' : 'PHP Developer | PHP & Symfony')
    : (de ? 'Erfahrener PHP- und Go-Entwickler' : 'Experienced PHP and Go Developer');
const intro = isGo
  ? (de ? 'Go-Backendentwickler mit rund 3 Jahren Go-Erfahrung und mehr als 10 Jahren PHP-Erfahrung, davon 7 Jahre mit Symfony. Ich entwickle Backend-Services und APIs mit Fokus auf Zuverlässigkeit, Performance und Betrieb. KI-gestützte Entwicklungstools nutze ich aktiv für Implementierung, Debugging und Tests und prüfe generierte Ergebnisse sorgfältig' : 'Go backend developer with around 3 years of Go experience and 10+ years of PHP experience, including 7 years with Symfony. I build backend services and APIs with a focus on reliability, performance and operations. I actively use AI-assisted development tools for implementation, debugging and testing, and carefully review generated output')
  : isPhp
    ? (de ? 'PHP- und Symfony-Entwickler mit mehr als 10 Jahren PHP-Erfahrung, davon 7 Jahre mit Symfony, sowie rund 3 Jahren Erfahrung mit Go. Ich entwickle APIs und Backend-Systeme und verbessere deren Qualität und Zuverlässigkeit. KI-gestützte Entwicklungstools nutze ich aktiv für Implementierung, Debugging und Tests und prüfe generierte Ergebnisse sorgfältig' : 'PHP and Symfony developer with 10+ years of PHP experience, including 7 years with Symfony, and around 3 years of Go experience. I build APIs and backend systems and improve their quality and reliability. I actively use AI-assisted development tools for implementation, debugging and testing, and carefully review generated output')
    : (de ? 'Softwareentwickler mit mehr als 10 Jahren PHP-Erfahrung, davon 7 Jahre mit Symfony, sowie rund 3 Jahren Erfahrung mit Go. Mein aktueller Fokus liegt auf Go und modernen Unternehmenslösungen. Ich verbessere Codequalität und Zuverlässigkeit, arbeite gerne eng mit meinem Team zusammen und nutze KI-gestützte Entwicklungstools aktiv für Implementierung, Debugging und Tests' : 'Software developer with 10+ years of PHP experience, including 7 years with Symfony, and around 3 years of Go experience. Currently focused on Go and modern enterprise solutions. I improve code quality and reliability, enjoy working closely with my team, and actively use AI-assisted development tools for implementation, debugging and testing');
const t = de ? {home:'Portfolio',overview:'Übersicht',goFocus:'Go',phpFocus:'PHP',contact:'Kontakt',experienceLink:'Erfahrung ansehen',more:'Mehr',skills:'Kenntnisse',experience:'Berufserfahrung',projects:'Projekte',education:'Ausbildung & Sprachen',city:'München · Deutschland',edu:'Plekhanov Russian University of Economics, Moskau',degree:'Abgeschlossener fünfjähriger Specialist-Abschluss in Angewandter Informatik in der Wirtschaft; Abschluss in anabin anerkannt',langs:'Russisch: Muttersprache · Deutsch: B2-Zertifikat, sicher in Gesprächen · Englisch: fließend'} : {home:'Portfolio',overview:'Overview',goFocus:'Go',phpFocus:'PHP',contact:'Get in touch',experienceLink:'View experience',more:'More',skills:'Skills',experience:'Experience',projects:'Projects',education:'Education & languages',city:'Munich · Germany',edu:'Plekhanov Russian University of Economics, Moscow',degree:'Completed five-year Specialist degree in Applied Informatics in Economics; diploma recognized in anabin',langs:'Russian: native · German: B2 certified; strong conversational skills · English: fluent'};
const available = isGo ? (de ? 'Offen für Go-Positionen' : 'Open to Go opportunities') : isPhp ? (de ? 'Offen für PHP-Positionen' : 'Open to PHP opportunities') : (de ? 'Offen für passende Go- und PHP-Positionen' : 'Open to suitable Go and PHP opportunities');
const groups = isGo
  ? (de ? [['Go & Backend','Go · REST APIs · Microservices'],['Cloud & Infrastruktur','AWS Lambda · AWS SQS · Docker · Kubernetes · Helm · Terraform · CI/CD'],['Tests','Testify · Go testing package'],['Daten & Messaging','MySQL · Redis · RabbitMQ · BigQuery'],['Weitere Technologien','PHP · Symfony · Python · JavaScript']] : [['Go & backend','Go · REST APIs · Microservices'],['Cloud & infrastructure','AWS Lambda · AWS SQS · Docker · Kubernetes · Helm · Terraform · CI/CD'],['Testing','Testify · Go testing package'],['Data & messaging','MySQL · Redis · RabbitMQ · BigQuery'],['Additional technologies','PHP · Symfony · Python · JavaScript']])
  : isPhp
    ? (de ? [['PHP & Frameworks','PHP · Symfony · REST APIs'],['Architektur','OOP · SOLID · DDD · GitFlow'],['Tests','PHPUnit · Prophecy · Codeception · Testify'],['Daten & Messaging','MySQL · Redis · RabbitMQ · AWS SQS · BigQuery'],['Cloud & Infrastruktur','Docker · Kubernetes · CI/CD · Helm · Terraform']] : [['PHP & frameworks','PHP · Symfony · REST APIs'],['Architecture','OOP · SOLID · DDD · GitFlow'],['Testing','PHPUnit · Prophecy · Codeception · Testify'],['Data & messaging','MySQL · Redis · RabbitMQ · AWS SQS · BigQuery'],['Cloud & infrastructure','Docker · Kubernetes · CI/CD · Helm · Terraform']])
    : (de ? [['Programmierung','PHP · Go · Python · JavaScript'],['Frameworks & Tests','Symfony · PHPUnit · Prophecy · Codeception · Testify'],['Daten & Messaging','MySQL · Redis · RabbitMQ · AWS SQS · BigQuery'],['Cloud & Infrastruktur','Docker · Kubernetes · CI/CD · Helm · Terraform'],['Architektur','OOP · SOLID · DDD · GitFlow · REST APIs']] : [['Programming','PHP · Go · Python · JavaScript'],['Frameworks & testing','Symfony · PHPUnit · Prophecy · Codeception · Testify'],['Data & messaging','MySQL · Redis · RabbitMQ · AWS SQS · BigQuery'],['Cloud & infrastructure','Docker · Kubernetes · CI/CD · Helm · Terraform'],['Architecture','OOP · SOLID · DDD · GitFlow · REST APIs']]);
const basePath = `/${lang}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImageUrl = new URL('/portrait.png', Astro.site);
const pageTitle = `Sergei Iurchenko — ${title}`;
const pageDescription = `${title} · Sergei Iurchenko, Munich`;
const focusedPath = (role) => `/${lang}/${role}/`;
const localePath = (targetLang) => focus === 'all' ? `/${targetLang}/` : `/${targetLang}/${focus}/`;
const displayedProjects = isPhp ? [projects[1], projects[2], projects[0]] : projects;
const pointScore = (point) => isGo
  ? (/\bGo\b|AWS Lambda|microservice|Fahrzeugsuche in Go|vehicle search in Go/i.test(point) ? 1 : 0)
  : isPhp
    ? (/PHP|Symfony|Laminas|CalDAV|RabbitMQ|SOAP/i.test(point) ? 1 : 0)
    : 0;
const displayedJobs = focus === 'all' ? jobs : jobs.map(job => ({ ...job, points: [...job.points].sort((a, b) => pointScore(b) - pointScore(a)) }));
---
<!doctype html>
<html lang={de ? 'de' : 'en'}>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="description" content={pageDescription}/>
    <link rel="canonical" href={canonicalUrl.href}/>
    <title>{pageTitle}</title>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={canonicalUrl.href}/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={pageDescription}/>
    <meta property="og:image" content={previewImageUrl.href}/>
    <meta property="og:image:type" content="image/png"/>
    <meta property="og:image:width" content="976"/>
    <meta property="og:image:height" content="1202"/>
    <meta property="og:image:alt" content="Portrait of Sergei Iurchenko"/>
    <meta name="twitter:card" content="summary_large_image"/>
  </head>
  <body>
    <main class="wrap">
      <nav class="topbar"><a class="brand" href={basePath}>{t.home}<span aria-hidden="true"> / SI</span></a><div class="focus-links"><a class={focus==='all'?'active':''} href={basePath}>{t.overview}</a><a class={isGo?'active':''} href={focusedPath('go')}>{t.goFocus}</a><a class={isPhp?'active':''} href={focusedPath('php')}>{t.phpFocus}</a></div><div class="lang"><a class={de?'active':''} href={localePath('de')}>DE</a><a class={!de?'active':''} href={localePath('en')}>EN</a></div></nav>
      <header class="hero"><div><div class="eyebrow">{t.city}</div><h1>Sergei<br/>Iurchenko</h1><p class="role">{title}</p><p class="intro">{intro}</p><div class="eyebrow">{available}</div><div class="actions"><a class="button" href="mailto:sergey.yurchenko.dev@gmail.com">{t.contact}</a><a class="button ghost" href="#experience">{t.experienceLink}</a></div><div class="contact"><a href="mailto:sergey.yurchenko.dev@gmail.com"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span>sergey.yurchenko.dev@gmail.com</span></a><a href="https://github.com/syurchen93" target="_blank" rel="noreferrer"><svg class="brand-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.08c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.02 3.64 1.54.1-.72.39-1.22.7-1.5-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.43.11-2.98 0 0 .94-.3 3.06 1.14a10.66 10.66 0 0 1 5.57 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.55.23 2.7.12 2.98.71.78 1.14 1.78 1.14 3.01 0 4.27-2.6 5.21-5.08 5.48.4.35.75 1.02.75 2.06V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg><span>GitHub</span></a><a href="https://www.linkedin.com/in/sergei-iurchenko-423b98254/" target="_blank" rel="noreferrer"><svg class="brand-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.34H4.98V9.5h2.95v8.84ZM6.45 8.3a1.71 1.71 0 1 1 .02-3.42 1.71 1.71 0 0 1-.02 3.42Zm11.9 10.04h-2.95v-4.3c0-1.03-.02-2.35-1.43-2.35-1.43 0-1.65 1.12-1.65 2.27v4.38H9.37V9.5h2.83v1.21h.04c.39-.7 1.35-1.43 2.78-1.43 2.98 0 3.53 1.96 3.53 4.51v4.55Z"/></svg><span>LinkedIn</span></a></div></div><img class="portrait" src="/portrait.png" alt="Sergei Iurchenko"/></header>
      <section class="section"><div class="section-head"><h2>{t.skills}</h2><span>01</span></div><div class="skills">{groups.map(([name,items])=><article class="skill"><h3>{name}</h3><p>{items}</p></article>)}</div></section>
      <section class="section" id="experience"><div class="section-head"><h2>{t.experience}</h2><span>02</span></div><div class="timeline">{displayedJobs.map(job=><article class="job"><div class="jobtop"><div><h3>{job.company} <span style="font-weight:400;color:#69766f">· {job.place}</span></h3><p class="title">{job.role}</p></div><div class="date">{job.date}</div></div><ul>{job.points.map(point=><li>{point}</li>)}</ul></article>)}</div></section>
      <section class="section"><div class="section-head"><h2>{t.projects}</h2><span>03</span></div><div class="projects">{displayedProjects.map(project=><article class="project"><h3>{project.href ? <a href={project.href} target="_blank" rel="noreferrer">{project.name} ↗</a> : project.name}</h3><ul><li>{project.desc}</li></ul>{project.note && <p class="tech">{project.note}</p>}<details class="project-more"><summary>{t.more}</summary><ul>{project.details.map(detail=><li>{detail}</li>)}</ul>{project.resources?.map(resource=><p class="tech"><a href={resource.href} target="_blank" rel="noreferrer">{resource.label} ↗</a></p>)}</details><p class="tech">{project.tech}</p></article>)}</div></section>
      <section class="section"><div class="section-head"><h2>{t.education}</h2><span>04</span></div><div class="bottom-grid"><article class="info"><h3>{de?'Ausbildung':'Education'}</h3><p><strong>{t.edu}</strong><br/>{t.degree}</p></article><article class="info"><h3>{de?'Sprachen':'Languages'}</h3><p>{t.langs}</p></article></div></section>
      <footer class="footer"><a href="mailto:sergey.yurchenko.dev@gmail.com">{t.contact} ↗</a><span>© {new Date().getFullYear()} Sergei Iurchenko</span></footer>
    </main>
  </body>
</html>
